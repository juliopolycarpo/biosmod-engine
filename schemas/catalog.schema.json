{
  "$defs": {
    "CatalogSource": {
      "additionalProperties": false,
      "description": "A source catalog of a merge, pinned by the digest of its `catalog.json`.",
      "properties": {
        "commit": {
          "description": "The commit checked out in the source directory at merge time, as 40 (SHA-1) or\n64 (SHA-256) lowercase hex characters. Uncommitted changes are covered by the\ndigest, not by the commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "The `id` in the source's `catalog.json`.",
          "type": "string"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Digest256",
          "description": "SHA-256 of the exact bytes of the source's `catalog.json`. This digest is the\nauthority: `repository` and `commit` only say where to fetch that content."
        },
        "repository": {
          "description": "The `repository` of the source's `catalog.json`, when it has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "manifest_sha256"
      ],
      "type": "object"
    },
    "Digest256": {
      "description": "SHA-256 digest, lowercase hexadecimal",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "FileEntry": {
      "additionalProperties": false,
      "description": "One indexed file.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest256"
        }
      },
      "required": [
        "path",
        "kind",
        "length",
        "sha256"
      ],
      "type": "object"
    },
    "FileKind": {
      "oneOf": [
        {
          "enum": [
            "board",
            "patch",
            "evidence"
          ],
          "type": "string"
        },
        {
          "const": "finding",
          "description": "A defect or observation, with or without a patch.",
          "type": "string"
        },
        {
          "const": "provenance",
          "description": "Supporting material (assembly sources, notes); hashed, never interpreted.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://github.com/juliopolycarpo/biosmod-engine/schemas/bme.catalog-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The catalog index.",
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "engine": {
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "repository": {
      "description": "The `https` URL of the repository that holds this catalog. Omitted when absent.",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "const": "bme.catalog/1",
      "type": "string"
    },
    "sources": {
      "description": "The catalogs a merge built this one from, in merge order. Omitted when empty.",
      "items": {
        "$ref": "#/$defs/CatalogSource"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "engine",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
