{
  "$defs": {
    "Digest256": {
      "description": "SHA-256 digest, lowercase hexadecimal",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EvidenceKind": {
      "oneOf": [
        {
          "const": "hardware-observation",
          "description": "Observed on physical hardware; scoped to its board, configuration and image.",
          "type": "string"
        },
        {
          "const": "offline-validation",
          "description": "Offline analysis or emulation.",
          "type": "string"
        }
      ]
    },
    "EvidencePatch": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "HostObservation": {
      "additionalProperties": false,
      "description": "Where and how a `bme diag` command observed the running machine.\n\nExample: `{\"command\": \"diag acpi capture\", \"boot_id\": \"98d86da9-...\",\n\"kernel_release\": \"7.0.0-42-generic\", \"digests\": {\"manifest.json\": \"ab...\"}}`",
      "properties": {
        "boot_id": {
          "description": "`/proc/sys/kernel/random/boot_id`: ties the record to one boot.",
          "type": "string"
        },
        "command": {
          "description": "The `bme` command that made the observation, such as `diag superio read`.",
          "type": "string"
        },
        "digests": {
          "additionalProperties": {
            "$ref": "#/$defs/Digest256"
          },
          "description": "SHA-256 of each artifact the record describes, by name.",
          "type": "object"
        },
        "kernel_release": {
          "description": "`/proc/sys/kernel/osrelease`.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "boot_id",
        "kernel_release",
        "digests"
      ],
      "type": "object"
    },
    "ReplayInput": {
      "additionalProperties": false,
      "description": "One input file of a replay: its role, name and digest.",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "description": "`harness`, `scenario` or `module`.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest256"
        }
      },
      "required": [
        "role",
        "name",
        "sha256"
      ],
      "type": "object"
    },
    "ReplayRun": {
      "additionalProperties": false,
      "description": "How an emulated run produced an evidence record: enough to repeat it and to notice that\nan input or the runtime changed.\n\nExample: a record from `bme replay script fan.py --module SioDxeInit.pe` lists `fan.py`\nand `SioDxeInit.pe` under `inputs` and the Unicorn version under `runtime`.",
      "properties": {
        "harness": {
          "description": "Harness script or scenario file name.",
          "type": "string"
        },
        "inputs": {
          "description": "Every file the run read.",
          "items": {
            "$ref": "#/$defs/ReplayInput"
          },
          "type": "array"
        },
        "output_sha256": {
          "$ref": "#/$defs/Digest256",
          "description": "SHA-256 of the JSON documents the run emitted, one per line."
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Interpreter and package versions that ran it, by name.",
          "type": "object"
        },
        "scenario": {
          "description": "Scenario id when a `bme.scenario/1` document drove the run.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "harness",
        "runtime",
        "inputs",
        "output_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/juliopolycarpo/biosmod-engine/schemas/bme.evidence-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A scoped observation about specific patch versions on specific hardware.",
  "properties": {
    "board": {
      "type": "string"
    },
    "built_with": {
      "type": [
        "string",
        "null"
      ]
    },
    "configuration": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": "string"
    },
    "firmware": {
      "type": "string"
    },
    "host": {
      "anyOf": [
        {
          "$ref": "#/$defs/HostObservation"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the running machine reported, for records made by `bme diag`."
    },
    "id": {
      "type": "string"
    },
    "image_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest256"
        },
        {
          "type": "null"
        }
      ],
      "description": "SHA-256 of the exact image tested, when one was flashed."
    },
    "kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "limits": {
      "type": "string"
    },
    "observations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "patches": {
      "items": {
        "$ref": "#/$defs/EvidencePatch"
      },
      "type": "array"
    },
    "replay": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayRun"
        },
        {
          "type": "null"
        }
      ],
      "description": "The harness, runtime and digests of an emulated run (`bme replay`)."
    },
    "schema": {
      "const": "bme.evidence/1",
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "kind",
    "date",
    "title",
    "board",
    "firmware",
    "patches",
    "observations",
    "limits"
  ],
  "title": "Evidence",
  "type": "object"
}
