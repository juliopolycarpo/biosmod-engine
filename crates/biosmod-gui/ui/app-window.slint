import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView, Spinner, TextEdit } from "std-widgets.slint";

export struct PatchRow {
    id: string,
    title: string,
    version: string,
    class: string,
    tier: string,
    state: string,
    blocker: string,
    evidence: string,
    selectable: bool,
    selected: bool,
}

global Theme {
    out property <brush> canvas: Palette.alternate-background;
    out property <brush> surface: Palette.background;
    out property <brush> border: Palette.border;
    out property <brush> text: Palette.foreground;
    out property <brush> muted: Palette.foreground.transparentize(0.3);
    out property <brush> accent: Palette.accent-background;
    out property <brush> accent-surface: Palette.accent-background;
    out property <brush> accent-text: Palette.accent-foreground;
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 17px;
    font-weight: 700;
}

component Caption inherits Text {
    color: Theme.muted;
    font-size: 13px;
    wrap: word-wrap;
}

component PatchCard inherits Rectangle {
    in property <PatchRow> patch;
    in property <bool> enabled: true;
    callback toggled();
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;
    height: patch-layout.preferred-height + 24px;
    patch-layout := VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            CheckBox {
                text: root.patch.title;
                checked: root.patch.selected;
                enabled: root.patch.selectable && root.enabled;
                toggled => { root.toggled(); }
                horizontal-stretch: 1;
            }
            Text {
                text: root.patch.state;
                color: Theme.accent;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        Caption { text: root.patch.id + "  ·  " + root.patch.version + "  ·  " + root.patch.class + "  ·  " + root.patch.tier; }
        if root.patch.blocker != "": Caption { text: root.patch.blocker; }
        if root.patch.evidence != "": Caption { text: root.patch.evidence; }
    }
}

export component AppWindow inherits Window {
    title: "BIOS Mod Engine";
    preferred-width: 1080px;
    preferred-height: 780px;
    min-width: 760px;
    min-height: 600px;
    background: Theme.canvas;

    in-out property <string> image-path;
    in-out property <string> output-path;
    in-out property <string> source;
    in-out property <string> engine-path;
    in property <string> engine-status: "Checking engine…";
    in property <string> status: "Choose a firmware image to get started.";
    in property <string> image-details;
    in property <string> scan-details;
    in property <string> plan-details;
    in property <string> result-details;
    in property <string> result-title: "Output & verification";
    in property <string> manifest-path;
    in property <string> source-details;
    in property <string> tool-details;
    in property <string> diagnostics;
    in property <string> operation-label;
    in property <string> elapsed;
    in property <[PatchRow]> patches;
    in property <bool> busy;
    in property <bool> can-cancel;
    in property <bool> can-inspect;
    in property <bool> can-scan;
    in property <bool> can-plan;
    in property <bool> can-recommend;
    in property <bool> can-apply;
    in property <bool> can-verify;
    in property <int> stage;
    in-out property <int> theme-choice: 0;
    private property <int> page: 0;
    private property <bool> paths-open;
    private property <bool> show-review;
    private property <string> manual-plan-path;
    private property <string> manual-output-path;
    private property <string> manual-export-path;

    callback image-edited(string);
    callback output-edited(string);
    callback source-edited(string);
    callback engine-edited(string);
    callback browse-image();
    callback browse-output();
    callback browse-engine();
    callback inspect();
    callback scan();
    callback toggle-patch(int);
    callback recommended();
    callback generate-plan();
    callback apply-plan();
    callback verify();
    callback cancel-operation();
    callback import-plan();
    callback open-output();
    callback refresh-sources();
    callback show-tools();
    callback refresh-engine();
    callback export-diagnostics();
    callback theme-changed(int);
    callback back-to-selection();
    callback open-plan-path(string);
    callback open-output-path(string);
    callback export-plan();
    callback export-plan-path(string);

    public function apply-theme() {
        Palette.color-scheme = root.theme-choice == 1 ? ColorScheme.light : root.theme-choice == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    VerticalLayout {
        spacing: 0;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            height: 56px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                VerticalLayout {
                    width: 36px;
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 9px;
                        background: Theme.accent-surface;
                        Text { text: "B"; font-size: 21px; font-weight: 700; color: Theme.accent-text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: "BIOS Mod Engine"; font-size: 16px; font-weight: 700; color: Theme.text; }
                    Text { text: "Firmware workspace"; font-size: 12px; color: Theme.muted; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.engine-status; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
                VerticalLayout {
                    alignment: center;
                    Button { text: "About"; clicked => { root.page = 3; } }
                }
            }
        }
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 4px;
            spacing: 8px;
            Button { text: root.page == 0 ? "• Workflow" : "Workflow"; clicked => { root.page = 0; } }
            Button { text: root.page == 1 ? "• Sources & tools" : "Sources & tools"; clicked => { root.page = 1; } }
            Button { text: root.page == 2 ? "• Diagnostics" : "Diagnostics"; clicked => { root.page = 2; } }
            Rectangle { horizontal-stretch: 1; }
            if root.page == 0: Button { text: "Open plan"; enabled: !root.busy; clicked => { root.import-plan(); } }
            if root.page == 0: Button { text: "Open output"; enabled: !root.busy; clicked => { root.open-output(); } }
            if root.page == 0: Button { text: root.paths-open ? "Hide paths" : "Enter paths"; enabled: !root.busy; clicked => { root.paths-open = !root.paths-open; } }
        }
        if root.page == 0: VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text { text: "Firmware workflow"; font-size: 24px; font-weight: 700; color: Theme.text; }
                    Caption { text: root.stage < 2 ? "Choose an image and source, then scan for corrections." : root.stage == 2 || root.show-review ? "Review the resolved plan before building a copy." : "Check the output and its offline verification."; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.stage < 2 ? "1 / 3  SELECT" : root.stage == 2 || root.show-review ? "2 / 3  REVIEW" : "3 / 3  VERIFY"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
            }
            if root.paths-open: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "Plan file path"; accessible-label: "Plan file path"; text <=> root.manual-plan-path; enabled: !root.busy; }
                    Button { text: "Open plan"; enabled: !root.busy && root.manual-plan-path != ""; clicked => { root.open-plan-path(root.manual-plan-path); root.paths-open = false; } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "Existing output image path"; accessible-label: "Existing output image path"; text <=> root.manual-output-path; enabled: !root.busy; }
                    Button { text: "Open output"; enabled: !root.busy && root.manual-output-path != ""; clicked => { root.open-output-path(root.manual-output-path); root.paths-open = false; } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "New plan export path"; accessible-label: "New plan export path"; text <=> root.manual-export-path; enabled: !root.busy && root.plan-details != ""; }
                    Button { text: "Save plan"; enabled: !root.busy && root.plan-details != "" && root.manual-export-path != ""; clicked => { root.export-plan-path(root.manual-export-path); root.paths-open = false; } }
                }
            }
            Rectangle {
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 8px;
                height: context-layout.preferred-height;
                context-layout := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    if root.stage < 2: VerticalLayout {
                        spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Image"; width: 54px; vertical-alignment: center; color: Theme.text; font-weight: 600; }
                        LineEdit {
                            placeholder-text: "Firmware image path";
                            accessible-label: "Firmware image path";
                            text <=> root.image-path;
                            enabled: !root.busy;
                            edited(value) => { root.image-edited(value); }
                        }
                        Button { text: "Browse…"; enabled: !root.busy; clicked => { root.browse-image(); } }
                        Button { text: "Inspect"; enabled: root.can-inspect && !root.busy; clicked => { root.inspect(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Source"; width: 54px; vertical-alignment: center; color: Theme.text; font-weight: 600; }
                        LineEdit {
                            placeholder-text: "Catalog source alias";
                            accessible-label: "Catalog source alias";
                            text <=> root.source;
                            enabled: !root.busy;
                            edited(value) => { root.source-edited(value); }
                        }
                        Button { text: "Scan image"; enabled: root.can-scan && !root.busy; clicked => { root.scan(); } }
                    }
                    }
                    if root.stage >= 2: HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Image"; width: 54px; vertical-alignment: center; color: Theme.text; font-weight: 600; }
                        LineEdit {
                            placeholder-text: "Original firmware image path";
                            accessible-label: "Original firmware image path";
                            text <=> root.image-path;
                            enabled: !root.busy;
                            edited(value) => { root.image-edited(value); }
                        }
                        Button { text: "Browse…"; enabled: !root.busy; clicked => { root.browse-image(); } }
                        Text { text: "Scan source: " + root.source; color: Theme.muted; overflow: elide; width: 132px; vertical-alignment: center; }
                    }
                }
            }
            if root.stage < 2: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    SectionTitle { text: "Findings"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.image-details != "": TextEdit { text: root.image-details; read-only: true; min-height: 42px; max-height: 60px; accessible-label: "Image details"; }
                if root.scan-details != "": Caption { text: root.scan-details; }
                if root.patches.length == 0: Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 8px;
                        alignment: center;
                        Text { text: "No findings to show"; font-size: 17px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                        Caption { text: "Scan an image with a catalog source to see findings and available corrections."; horizontal-alignment: center; }
                    }
                }
                if root.patches.length > 0: ListView {
                    vertical-stretch: 1;
                    min-height: 80px;
                    for patch[i] in root.patches: PatchCard { patch: patch; enabled: !root.busy; toggled => { root.toggle-patch(i); } }
                }
                Caption { text: "Hardware-dependent findings and corrections that require joint selection cannot be applied here yet."; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Recommended"; enabled: root.can-recommend && !root.busy; clicked => { root.recommended(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Review selected"; enabled: root.can-plan && !root.busy; clicked => { root.generate-plan(); } }
                }
            }
            if root.stage >= 2 && (root.stage == 2 || root.show-review): VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    SectionTitle { text: "Review plan"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Export plan…"; enabled: !root.busy && root.plan-details != ""; clicked => { root.export-plan(); } }
                    if root.stage >= 3: Button { text: "Show output"; clicked => { root.show-review = false; } }
                    Button { text: "Back to findings"; enabled: !root.busy; clicked => { root.show-review = false; root.back-to-selection(); } }
                }
                Caption { text: "Confirm the source, changes, and expected output before building."; }
                TextEdit { text: root.plan-details; read-only: true; min-height: 100px; accessible-label: "Plan details"; }
                SectionTitle { text: "New output"; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: "New output image path";
                        accessible-label: "New output image path";
                        text <=> root.output-path;
                        enabled: !root.busy;
                        edited(value) => { root.output-edited(value); }
                    }
                    Button { text: "Choose…"; enabled: !root.busy; clicked => { root.browse-output(); } }
                }
                if root.output-path != "": Caption { text: "Manifest: " + (root.manifest-path == "" ? root.output-path + ".manifest.json" : root.manifest-path); }
                HorizontalLayout {
                    spacing: 8px;
                    Caption { text: "The original image will not be overwritten."; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Build patched copy"; enabled: root.can-apply && !root.busy; clicked => { root.apply-plan(); } }
                }
            }
            if root.stage >= 3 && !root.show-review: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    SectionTitle { text: root.result-title; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.plan-details != "": Button { text: "Review plan"; clicked => { root.show-review = true; } }
                    Button { text: "Back to findings"; enabled: !root.busy; clicked => { root.back-to-selection(); } }
                }
                if root.output-path != "": Caption { text: "Output: " + root.output-path; }
                if root.manifest-path != "": Caption { text: "Manifest: " + root.manifest-path; }
                TextEdit { text: root.result-details; read-only: true; min-height: 100px; accessible-label: "Verification results"; }
                HorizontalLayout {
                    spacing: 8px;
                    Caption { text: "Offline verification does not establish hardware boot behavior."; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Verify output"; enabled: root.can-verify && !root.busy; clicked => { root.verify(); } }
                }
            }
        }
        if root.page == 1: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: "Sources & tools"; font-size: 24px; font-weight: 700; color: Theme.text; }
            Caption { text: "Inspect configured catalog sources and engine tools."; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Refresh sources"; enabled: !root.busy; clicked => { root.refresh-sources(); } }
                Button { text: "Check tools"; enabled: !root.busy; clicked => { root.show-tools(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            SectionTitle { text: "Catalog sources"; }
            TextEdit { text: root.source-details; placeholder-text: "Refresh to view configured sources."; read-only: true; accessible-label: "Catalog sources"; }
            SectionTitle { text: "Tools"; }
            TextEdit { text: root.tool-details; placeholder-text: "Check tools to view their status."; read-only: true; accessible-label: "Tool diagnostics"; }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "Engine"; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            placeholder-text: "Path to bme executable";
                            accessible-label: "Engine executable path";
                            text <=> root.engine-path;
                            enabled: !root.busy;
                            edited(value) => { root.engine-edited(value); }
                        }
                        Button { text: "Browse…"; enabled: !root.busy; clicked => { root.browse-engine(); } }
                        Button { text: "Check engine"; enabled: !root.busy; clicked => { root.refresh-engine(); } }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "Appearance"; }
                    ComboBox {
                        accessible-label: "Appearance";
                        model: ["Follow system", "Light", "Dark"];
                        current-index <=> root.theme-choice;
                        selected(value) => { root.apply-theme(); root.theme-changed(root.theme-choice); }
                    }
                }
            }
        }
        if root.page == 2: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: "Diagnostics"; font-size: 24px; font-weight: 700; color: Theme.text; }
            Caption { text: "Recent operation details. Select text to copy it."; }
            diagnostics-field := TextEdit { text: root.diagnostics; read-only: true; accessible-label: "Recent diagnostics"; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Copy all"; enabled: root.diagnostics != ""; clicked => { diagnostics-field.select-all(); diagnostics-field.copy(); } }
                Button { text: "Export…"; enabled: root.diagnostics != ""; clicked => { root.export-diagnostics(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        if root.page == 3: VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text { text: "About BIOS Mod Engine"; font-size: 24px; font-weight: 700; color: Theme.text; }
            Caption { text: "Inspect firmware and build a reviewed copy using the BIOS Mod Engine command-line tool."; }
            Caption { text: "Firmware matches and offline verification do not establish physical hardware compatibility or boot behavior."; }
            AboutSlint { }
            Rectangle { vertical-stretch: 1; }
        }
        Rectangle {
            height: 44px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 8px;
                if root.busy: Spinner { width: 30px; height: 30px; indeterminate: true; }
                Text { text: root.busy ? root.operation-label + "  " + root.elapsed : root.status; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                if root.busy && root.can-cancel: Button { text: "Cancel"; clicked => { root.cancel-operation(); } }
            }
        }
    }
}
