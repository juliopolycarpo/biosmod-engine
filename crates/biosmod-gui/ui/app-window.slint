import { AboutSlint, Button, ComboBox, LineEdit, ListView, Palette, Spinner, TextEdit } from "std-widgets.slint";
import { PatchCard, PatchRow } from "patch-card.slint";
import { Stepper } from "stepper.slint";
import { Theme } from "theme.slint";
import { Caption, Chip, Tone, Tones, Divider, FieldRow, NavTab, PageTitle, SectionTitle } from "widgets.slint";
import { Fact, FindingsSummary } from "facts.slint";
import { UiText } from "translations.slint";

export { Fact, PatchRow, Theme, UiText }

export component AppWindow inherits Window {
    title: "BIOS Mod Engine";
    preferred-width: 1080px;
    preferred-height: 780px;
    min-width: 760px;
    min-height: 600px;
    background: Theme.canvas;

    in-out property <string> image-path;
    in-out property <string> output-path;
    in-out property <string> source;
    in-out property <string> engine-path;
    in property <string> app-version;
    in property <string> engine-status: @tr("Checking engine…");
    in property <string> status: @tr("Choose a firmware image to get started.");
    in property <Tone> status-tone: Tone.quiet;
    in property <Tone> engine-tone: Tone.attention;
    in property <[Fact]> image-facts;
    in property <[Fact]> scan-facts;
    in property <string> image-sha;
    in property <string> plan-details;
    in property <string> result-details;
    in property <string> result-title: @tr("Output & verification");
    in property <string> manifest-path;
    in property <string> source-details;
    in property <string> tool-details;
    in property <string> diagnostics;
    in property <string> operation-label;
    in property <string> elapsed;
    in property <[PatchRow]> patches;
    in property <bool> busy;
    in property <bool> can-cancel;
    in property <bool> can-inspect;
    in property <bool> can-scan;
    in property <bool> can-plan;
    in property <bool> can-recommend;
    in property <bool> can-apply;
    in property <bool> can-verify;
    in property <int> stage;
    in-out property <int> theme-choice: 0;
    in-out property <int> language-index: 0;
    in-out property <int> page: 0;
    in-out property <bool> paths-open;
    // Side padding that keeps content at most Theme.content-max wide and centered.
    private property <length> gutter: max(Theme.space-xl, (root.width - Theme.content-max) / 2);
    private property <bool> show-review;
    private property <bool> engine-dirty;
    private property <string> manual-plan-path;
    private property <string> manual-output-path;
    private property <string> manual-export-path;

    changed page => {
        if root.page != 4 && root.engine-dirty {
            root.engine-committed(root.engine-path);
            root.engine-dirty = false;
        }
    }

    callback image-edited(string);
    callback output-edited(string);
    callback source-edited(string);
    callback engine-edited(string);
    callback engine-committed(string);
    callback browse-image();
    callback browse-output();
    callback browse-engine();
    callback inspect();
    callback scan();
    callback toggle-patch(int);
    callback recommended();
    callback generate-plan();
    callback apply-plan();
    callback verify();
    callback cancel-operation();
    callback import-plan();
    callback open-output();
    callback refresh-sources();
    callback show-tools();
    callback refresh-engine();
    callback export-diagnostics();
    callback theme-changed(int);
    callback language-changed(int);
    callback back-to-selection();
    callback open-plan-path(string);
    callback open-output-path(string);
    callback export-plan();
    callback export-plan-path(string);

    public function apply-theme() {
        Palette.color-scheme = root.theme-choice == 1 ? ColorScheme.light : root.theme-choice == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    VerticalLayout {
        spacing: 0;
        Rectangle {
            background: Theme.surface;
            height: header-layout.preferred-height;
            header-layout := VerticalLayout {
                HorizontalLayout {
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    spacing: Theme.space-sm;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: Theme.accent;
                            Text { text: "B"; font-size: Theme.font-heading; font-weight: 700; color: Theme.accent-text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if root.width >= 1080px: Text { text: @tr("BIOS Mod Engine"); font-size: Theme.font-heading; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    Rectangle { width: Theme.space-md; }
                    NavTab { text: @tr("Workflow"); selected: root.page == 0; activated => { root.page = 0; } }
                    NavTab { text: @tr("Sources & tools"); selected: root.page == 1; activated => { root.page = 1; } }
                    NavTab { text: @tr("Diagnostics"); selected: root.page == 2; activated => { root.page = 2; } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.width >= 1000px: VerticalLayout {
                        alignment: center;
                        Chip { text: root.engine-status; tone: root.engine-tone; }
                    }
                    if root.width >= 1000px: NavTab { text: @tr("Settings"); selected: root.page == 4; activated => { root.page = 4; } }
                    if root.width >= 1000px: NavTab { text: @tr("About"); selected: root.page == 3; activated => { root.page = 3; } }
                }
                if root.width < 1000px: HorizontalLayout {
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    spacing: Theme.space-sm;
                    VerticalLayout {
                        alignment: center;
                        Chip { text: root.engine-status; tone: root.engine-tone; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    NavTab { text: @tr("Settings"); selected: root.page == 4; activated => { root.page = 4; } }
                    NavTab { text: @tr("About"); selected: root.page == 3; activated => { root.page = 3; } }
                }
                Divider { }
            }
        }
        if root.page == 0: VerticalLayout {
            padding-left: root.gutter;
            padding-right: root.gutter;
            padding-top: Theme.space-md;
            padding-bottom: Theme.space-md;
            spacing: Theme.space-sm;
            HorizontalLayout {
                spacing: Theme.space-sm;
                Stepper { current: root.stage < 2 ? 0 : root.stage == 2 || root.show-review ? 1 : root.status-tone == Tone.good ? 3 : 2; }
                Rectangle { horizontal-stretch: 1; }
                if root.width >= 1000px: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Button { text: @tr("Open plan"); enabled: !root.busy; clicked => { root.import-plan(); } }
                        Button { text: @tr("Open output"); enabled: !root.busy; clicked => { root.open-output(); } }
                        Button { text: root.paths-open ? @tr("Hide paths") : @tr("Enter paths"); enabled: !root.busy; clicked => { root.paths-open = !root.paths-open; } }
                    }
                }
            }
            if root.width < 1000px: HorizontalLayout {
                spacing: Theme.space-sm;
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Open plan"); enabled: !root.busy; clicked => { root.import-plan(); } }
                Button { text: @tr("Open output"); enabled: !root.busy; clicked => { root.open-output(); } }
                Button { text: root.paths-open ? @tr("Hide paths") : @tr("Enter paths"); enabled: !root.busy; clicked => { root.paths-open = !root.paths-open; } }
            }
            if root.paths-open: Rectangle {
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.radius;
                height: paths-layout.preferred-height;
                paths-layout := VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    FieldRow {
                        label: @tr("Plan");
                        LineEdit { placeholder-text: @tr("Plan file path"); accessible-label: @tr("Plan file path"); text <=> root.manual-plan-path; enabled: !root.busy; }
                        Button { text: @tr("Open plan"); enabled: !root.busy && root.manual-plan-path != ""; clicked => { root.open-plan-path(root.manual-plan-path); root.paths-open = false; } }
                    }
                    FieldRow {
                        label: @tr("Output");
                        LineEdit { placeholder-text: @tr("Existing output image path"); accessible-label: @tr("Existing output image path"); text <=> root.manual-output-path; enabled: !root.busy; }
                        Button { text: @tr("Open output"); enabled: !root.busy && root.manual-output-path != ""; clicked => { root.open-output-path(root.manual-output-path); root.paths-open = false; } }
                    }
                    FieldRow {
                        label: @tr("Save as");
                        LineEdit { placeholder-text: @tr("New plan export path"); accessible-label: @tr("New plan export path"); text <=> root.manual-export-path; enabled: !root.busy && root.plan-details != ""; }
                        Button { text: @tr("Save plan"); enabled: !root.busy && root.plan-details != "" && root.manual-export-path != ""; clicked => { root.export-plan-path(root.manual-export-path); root.paths-open = false; } }
                    }
                }
            }
            Rectangle {
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.radius;
                height: context-layout.preferred-height;
                context-layout := VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    FieldRow {
                        label: @tr("Image");
                        LineEdit {
                            placeholder-text: @tr("Original firmware image path");
                            accessible-label: @tr("Original firmware image path");
                            text <=> root.image-path;
                            enabled: !root.busy;
                            edited(value) => { root.image-edited(value); }
                        }
                        Button { text: @tr("Browse…"); enabled: !root.busy; clicked => { root.browse-image(); } }
                        if root.stage < 2: Button { text: @tr("Inspect"); enabled: root.can-inspect && !root.busy; clicked => { root.inspect(); } }
                        if root.stage >= 2: VerticalLayout {
                            alignment: center;
                            Chip { text: @tr("Source: {}", root.source); }
                        }
                    }
                    if root.stage < 2: FieldRow {
                        label: @tr("Source");
                        LineEdit {
                            placeholder-text: @tr("Catalog source alias");
                            accessible-label: @tr("Catalog source alias");
                            text <=> root.source;
                            enabled: !root.busy;
                            edited(value) => { root.source-edited(value); }
                        }
                        Button { text: @tr("Scan image"); primary: root.patches.length == 0; enabled: root.can-scan && !root.busy; clicked => { root.scan(); } }
                    }
                }
            }
            if root.stage < 2: VerticalLayout {
                spacing: Theme.space-sm;
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    SectionTitle { text: @tr("Findings"); vertical-alignment: center; }
                    if root.patches.length > 0: VerticalLayout {
                        alignment: center;
                        Chip { text: @tr("{n} finding" | "{n} findings" % root.patches.length); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // While the manual paths panel is open on a short window, the summary yields its rows
                // so the footer and status bar stay on screen.
                if (root.image-facts.length > 0 || root.scan-facts.length > 0) && !(root.paths-open && root.height < 700px): FindingsSummary {
                    image-facts: root.image-facts;
                    scan-facts: root.scan-facts;
                    image-sha: root.image-sha;
                    compact: root.height < 700px;
                }
                if root.patches.length == 0: Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Theme.space-xl;
                        spacing: Theme.space-sm;
                        alignment: center;
                        Text { text: @tr("No findings to show"); font-size: Theme.font-heading; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                        Caption { text: root.can-scan ? @tr("Press Scan image to look for corrections in the catalog.") : @tr("Choose an image and enter a catalog source alias to enable scanning."); horizontal-alignment: center; }
                    }
                }
                if root.patches.length > 0: ListView {
                    vertical-stretch: 1;
                    min-height: root.paths-open && root.height < 700px ? 0px : 80px;
                    for patch[i] in root.patches: PatchCard { patch: patch; enabled: !root.busy; toggled => { root.toggle-patch(i); } }
                }
                Caption { text: root.scan-facts.length > 0 ? @tr("Board profiles are catalog information, not physical board identification. Hardware-dependent findings and corrections that require joint selection cannot be applied here yet.") : @tr("Hardware-dependent findings and corrections that require joint selection cannot be applied here yet."); }
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    Button { text: @tr("Recommended"); enabled: root.can-recommend && !root.busy; clicked => { root.recommended(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Review selected"); primary: true; enabled: root.can-plan && !root.busy; clicked => { root.generate-plan(); } }
                }
            }
            if root.stage >= 2 && (root.stage == 2 || root.show-review): VerticalLayout {
                spacing: Theme.space-md;
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    SectionTitle { text: @tr("Review plan"); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Export plan…"); enabled: !root.busy && root.plan-details != ""; clicked => { root.export-plan(); } }
                    if root.stage >= 3: Button { text: @tr("Show output"); clicked => { root.show-review = false; } }
                    Button { text: @tr("Back to findings"); enabled: !root.busy; clicked => { root.show-review = false; root.back-to-selection(); } }
                }
                Caption { text: @tr("Confirm the source, changes, and expected output before building."); }
                TextEdit { text: root.plan-details; read-only: true; min-height: 100px; accessible-label: @tr("Plan details"); }
                Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: Theme.radius;
                    height: output-layout.preferred-height;
                    output-layout := VerticalLayout {
                        padding: Theme.space-md;
                        spacing: Theme.space-sm;
                        FieldRow {
                            label: @tr("Output");
                            LineEdit {
                                placeholder-text: @tr("New output image path");
                                accessible-label: @tr("New output image path");
                                text <=> root.output-path;
                                enabled: !root.busy;
                                edited(value) => { root.output-edited(value); }
                            }
                            Button { text: @tr("Choose…"); enabled: !root.busy; clicked => { root.browse-output(); } }
                        }
                        if root.output-path != "": Caption { text: @tr("Manifest: {}", root.manifest-path == "" ? root.output-path + ".manifest.json" : root.manifest-path); }
                        HorizontalLayout {
                            spacing: Theme.space-sm;
                            Caption { text: @tr("The original image will not be overwritten."); vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: @tr("Build patched copy"); primary: true; enabled: root.can-apply && !root.busy; clicked => { root.apply-plan(); } }
                        }
                    }
                }
            }
            if root.stage >= 3 && !root.show-review: VerticalLayout {
                spacing: Theme.space-md;
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    SectionTitle { text: root.result-title; color: root.status-tone != Tone.quiet ? Tones.color(root.status-tone) : Theme.text; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.plan-details != "": Button { text: @tr("Review plan"); clicked => { root.show-review = true; } }
                    Button { text: @tr("Back to findings"); enabled: !root.busy; clicked => { root.back-to-selection(); } }
                }
                if root.output-path != "": Caption { text: @tr("Output: {}", root.output-path); }
                if root.manifest-path != "": Caption { text: @tr("Manifest: {}", root.manifest-path); }
                TextEdit { text: root.result-details; read-only: true; min-height: 100px; accessible-label: @tr("Verification results"); }
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    Caption { text: @tr("Offline verification does not establish hardware boot behavior."); vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Verify output"); primary: true; enabled: root.can-verify && !root.busy; clicked => { root.verify(); } }
                }
            }
        }
        if root.page == 1: VerticalLayout {
            padding-left: root.gutter;
            padding-right: root.gutter;
            padding-top: Theme.space-xl;
            padding-bottom: Theme.space-xl;
            spacing: Theme.space-md;
            PageTitle { text: @tr("Sources & tools"); }
            Caption { text: @tr("Read-only status of the configured catalog sources and engine tools. Use the CLI to change them."); }
            HorizontalLayout {
                spacing: Theme.space-lg;
                VerticalLayout {
                    spacing: Theme.space-sm;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        SectionTitle { text: @tr("Catalog sources"); vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: @tr("Refresh sources"); enabled: !root.busy; clicked => { root.refresh-sources(); } }
                    }
                    TextEdit { text: root.source-details; placeholder-text: @tr("Refresh to view configured sources."); read-only: true; accessible-label: @tr("Catalog sources"); }
                }
                VerticalLayout {
                    spacing: Theme.space-sm;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        SectionTitle { text: @tr("Tools"); vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: @tr("Check tools"); enabled: !root.busy; clicked => { root.show-tools(); } }
                    }
                    TextEdit { text: root.tool-details; placeholder-text: @tr("Check tools to view their status."); read-only: true; accessible-label: @tr("Tool diagnostics"); }
                }
            }
        }
        if root.page == 4: VerticalLayout {
            padding-left: root.gutter;
            padding-right: root.gutter;
            padding-top: Theme.space-xl;
            padding-bottom: Theme.space-xl;
            spacing: Theme.space-md;
            PageTitle { text: @tr("Settings"); }
            Caption { text: @tr("Changes are saved as you make them."); }
            Rectangle {
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.radius;
                height: settings-layout.preferred-height;
                settings-layout := VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-md;
                    FieldRow {
                        label: @tr("Engine");
                        LineEdit {
                            placeholder-text: @tr("Path to bme executable");
                            accessible-label: @tr("Engine executable path");
                            text <=> root.engine-path;
                            enabled: !root.busy;
                            edited(value) => { root.engine-dirty = true; root.engine-edited(value); }
                            accepted(value) => {
                                root.engine-committed(value);
                                root.engine-dirty = false;
                            }
                            changed has-focus => {
                                if !self.has-focus && root.engine-dirty {
                                    root.engine-committed(self.text);
                                    root.engine-dirty = false;
                                }
                            }
                        }
                        Button { text: @tr("Browse…"); enabled: !root.busy; clicked => { root.browse-engine(); } }
                        Button { text: @tr("Check engine"); enabled: !root.busy; clicked => { root.refresh-engine(); } }
                    }
                    FieldRow {
                        label: @tr("Language");
                        ComboBox {
                            accessible-label: @tr("Language");
                            model: ["English", "Português (Brasil)"];
                            current-index <=> root.language-index;
                            selected(value) => { root.language-changed(root.language-index); }
                            horizontal-stretch: 0;
                            width: 200px;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    FieldRow {
                        label: @tr("Theme");
                        ComboBox {
                            accessible-label: @tr("Appearance");
                            model: [@tr("Follow system"), @tr("Light"), @tr("Dark")];
                            current-index <=> root.theme-choice;
                            selected(value) => { root.apply-theme(); root.theme-changed(root.theme-choice); }
                            horizontal-stretch: 0;
                            width: 200px;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
        if root.page == 2: VerticalLayout {
            padding-left: root.gutter;
            padding-right: root.gutter;
            padding-top: Theme.space-xl;
            padding-bottom: Theme.space-xl;
            spacing: Theme.space-md;
            PageTitle { text: @tr("Diagnostics"); }
            Caption { text: @tr("Recent operation details. Select text to copy it."); }
            diagnostics-field := TextEdit { text: root.diagnostics; read-only: true; accessible-label: @tr("Recent diagnostics"); }
            HorizontalLayout {
                spacing: Theme.space-sm;
                Button { text: @tr("Copy all"); enabled: root.diagnostics != ""; clicked => { diagnostics-field.select-all(); diagnostics-field.copy(); } }
                Button { text: @tr("Export…"); enabled: root.diagnostics != ""; clicked => { root.export-diagnostics(); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        if root.page == 3: VerticalLayout {
            padding-left: root.gutter;
            padding-right: root.gutter;
            padding-top: Theme.space-xl;
            padding-bottom: Theme.space-xl;
            spacing: Theme.space-lg;
            alignment: start;
            Rectangle {
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.radius;
                height: about-layout.preferred-height;
                about-layout := VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 12px;
                            background: Theme.accent;
                            Text { text: "B"; font-size: Theme.font-title; font-weight: 700; color: Theme.accent-text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.space-xs;
                            SectionTitle { text: @tr("BIOS Mod Engine"); }
                            Caption { text: @tr("Version {}", root.app-version); }
                        }
                    }
                    Caption { text: @tr("Inspect firmware and build a reviewed copy using the BIOS Mod Engine command-line tool."); color: Theme.text; }
                    Caption { text: @tr("Firmware matches and offline verification do not establish physical hardware compatibility or boot behavior."); }
                }
            }
            HorizontalLayout {
                alignment: start;
                AboutSlint { width: 320px; height: 200px; }
            }
        }
        Rectangle {
            height: 44px;
            background: Theme.surface;
            VerticalLayout {
                Divider { }
                HorizontalLayout {
                    padding-left: root.gutter;
                    padding-right: root.gutter;
                    spacing: Theme.space-sm;
                    if root.busy: VerticalLayout {
                        alignment: center;
                        Spinner { width: 22px; height: 22px; indeterminate: true; }
                    }
                    if !root.busy && root.status-tone != Tone.quiet: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: Tones.color(root.status-tone);
                        }
                    }
                    Text {
                        text: root.busy ? root.operation-label + "  " + root.elapsed : root.status;
                        color: !root.busy && root.status-tone != Tone.quiet ? Tones.color(root.status-tone) : Theme.muted;
                        font-size: Theme.font-body;
                        font-weight: !root.busy && root.status-tone != Tone.quiet ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.busy && root.can-cancel: Button { text: @tr("Cancel"); clicked => { root.cancel-operation(); } }
                }
            }
        }
    }
}
