// Presentation text consumed on the UI thread by the desktop adapter.
export global UiText {
    out property <string> defect-present: @tr("Defect present");
    out property <string> fixed: @tr("Fixed");
    out property <string> partially-patched: @tr("Partially patched");
    out property <string> likely-present: @tr("Likely present");
    out property <string> likely-fixed: @tr("Likely fixed");
    out property <string> not-detected: @tr("Not detected");
    out property <string> not-applicable: @tr("Not applicable");
    out property <string> unsupported: @tr("Unsupported");
    out property <string> selection-limit: @tr("Desktop selection requires a present, independently plannable correction without hold or hardware gates. Joint prerequisites require the CLI.");
    out property <string> no-evidence: @tr("No hardware observations for this patch version.");
    public pure function requires-facts(facts: string) -> string { return @tr("Requires physical observations: {}. Review with the CLI.", facts); }
    public pure function scoped-evidence(evidence: string) -> string { return @tr("Scoped evidence: {}. See Sources & tools for image, board and scenario.", evidence); }

    out property <string> size: @tr("Size");
    out property <string> volumes: @tr("Volumes");
    out property <string> layout: @tr("Layout");
    out property <string> bare-bios: @tr("Bare BIOS / firmware volumes");
    out property <string> flash-descriptor: @tr("Intel flash descriptor");
    public pure function bytes-size(size: string) -> string { return @tr("{} bytes", size); }
    out property <string> source: @tr("Source");
    out property <string> trust: @tr("Trust");
    out property <string> firmware: @tr("Firmware");
    out property <string> boards: @tr("Boards");
    out property <string> no-boards: @tr("none matched");
    out property <string> unknown-firmware: @tr("unknown or ambiguous");

    out property <string> save-copy: @tr("Save a new patched copy");
    out property <string> export-plan: @tr("Export selection to a new file");
    out property <string> export-diagnostics: @tr("Export diagnostics to a new file");
    out property <string> open-plan: @tr("Open a selection file");
    out property <string> plan-filter: @tr("Plan");
    out property <string> choose-engine: @tr("Choose bme executable");
    out property <string> open-output: @tr("Open a built image with its paired manifest");
    out property <string> open-image: @tr("Open firmware image");
    public pure function preferences-error(error: string) -> string { return @tr("Could not save preferences: {}", error); }
    out property <string> preferences-no-location: @tr("Could not save preferences: no writable configuration location is available.");
    public pure function preferences-protected(path: string) -> string { return @tr("Preferences not saved: {} could not be read. Fix or remove that file, then restart.", path); }
    out property <string> generated-plan: @tr("Preview of selected changes");
    out property <string> imported-plan: @tr("Imported selection file");
    out property <string> none: @tr("None");
    out property <string> unknown: @tr("unknown");
    public pure function plan-intro(firmware: string, alias: string, catalog: string, version: string, trust: string, requested: string, selected: string, carried: string, input: string, output: string, engine: string, codec: string) -> string {
        return @tr("Firmware: {}\nSource: {} · {} {} · {}\n\nRequested: {}\nSelected: {}\nAlready carried: {}\n\nInput SHA-256: {}\nOutput SHA-256: {}\nEngine: {} · {}\n\n", firmware, alias, catalog, version, trust, requested, selected, carried, input, output, engine, codec);
    }
    public pure function plan-component(name: string, guid: string, table: string, file: string, patches: string) -> string {
        return @tr("{} · {} · table offset {} · file offset {}\n  {}\n", name, guid, table, file, patches);
    }
    public pure function plan-end(facts: string, hold: string, diagnostic: string, notes: string) -> string {
        return @tr("\nHardware assertions: {}\nAllow hold: {} · Allow diagnostic: {}\n{}\n\nComplete plan and source snapshot\n", facts, hold, diagnostic, notes);
    }
    out property <string> offline-checks: @tr("Independent offline checks");
    out property <string> input-digest: @tr("Original image digest");
    out property <string> output-digest: @tr("Output digest");
    out property <string> structure: @tr("Firmware structure");
    out property <string> unchanged: @tr("Bytes outside the allowed changes");
    out property <string> changed: @tr("Changed regions");
    out property <string> patch-states: @tr("Selected patch states");
    out property <string> reproduced: @tr("Independent reproduction from the catalog");
    out property <string> unknown-check: @tr("unknown check");
    public pure function check-passed(name: string) -> string { return @tr("PASS  {}", name); }
    public pure function check-incomplete(name: string) -> string { return @tr("INCOMPLETE  {}", name); }
    public pure function check-skipped(name: string, reason: string) -> string { return @tr("SKIPPED  {}\n{}", name, reason); }
    out property <string> status-start: @tr("Choose a firmware image to get started.");
    out property <string> status-inputs: @tr("Inputs changed. Inspect and scan to continue.");
    out property <string> status-imported-input: @tr("Scan the original image and matching catalog to validate the selection file.");
    out property <string> status-selection: @tr("Selection changed.");
    out property <string> status-ready: @tr("Engine ready. Choose an image to inspect.");
    out property <string> status-inspected: @tr("Image inspected. Scan a source for matching corrections.");
    out property <string> status-scanned: @tr("Scan complete. Select corrections or choose Recommended.");
    out property <string> status-previewed: @tr("Preview complete.");
    out property <string> status-published: @tr("Patched copy published. Independent verification is next.");
    out property <string> status-verified-opened: @tr("Verified against the opened manifest");
    out property <string> status-verified: @tr("Offline verification complete");
    out property <string> status-incomplete: @tr("Verification incomplete. Review skipped checks and retry after addressing them.");
    out property <string> status-sources: @tr("Registered sources loaded. Firmware operations remain offline.");
    out property <string> status-tools: @tr("Tool diagnostics complete.");
    out property <string> status-recipe-validated: @tr("Selection file validated. Choose an output and build a copy.");
    out property <string> status-imported: @tr("Selection file opened. Choose its original image and catalog.");
    out property <string> status-stopping: @tr("Stopping operation…");
    out property <string> status-back: @tr("Select corrections to build a patched copy.");
    out property <string> status-closing-export: @tr("Finishing file export before closing…");
    out property <string> status-closing-build: @tr("Building the copy. Close the window after publication finishes.");
    out property <string> status-closing-stop: @tr("Stopping operation before closing…");
    out property <string> status-export-needs-plan: @tr("Select corrections or open a selection file to export.");
    out property <string> operation-connect: @tr("Checking engine");
    out property <string> operation-inspect: @tr("Inspecting image");
    out property <string> operation-scan: @tr("Scanning image");
    out property <string> operation-preview: @tr("Previewing changes");
    out property <string> operation-export-selection: @tr("Exporting selection");
    out property <string> operation-apply: @tr("Building patched copy");
    out property <string> operation-verify: @tr("Verifying output");
    out property <string> operation-sources: @tr("Reading sources");
    out property <string> operation-tools: @tr("Checking tools");
    out property <string> operation-validate-recipe: @tr("Validating selection file");
    out property <string> operation-import: @tr("Opening selection file");
    out property <string> operation-export: @tr("Exporting file");
    out property <string> operation-pick: @tr("Choosing file");
    out property <string> engine-disconnected: @tr("Engine not connected");
    out property <string> engine-unavailable: @tr("Engine unavailable");
    public pure function engine-ready(version: string) -> string { return @tr("bme {} · offline", version); }
    public pure function status-failed(detail: string) -> string { return @tr("Operation failed: {}", detail); }
    public pure function status-publication-unknown(detail: string) -> string { return @tr("Publication outcome unknown. Inspect output artifacts before retrying. {}", detail); }
    out property <string> title-verification-failed: @tr("Verification failed for this output");
    out property <string> title-publication-unknown: @tr("Publication outcome unknown");
    out property <string> title-incomplete: @tr("Verification incomplete");
    out property <string> title-publication: @tr("Publication incomplete: inspect remaining artifacts");
    out property <string> title-interrupted: @tr("Operation interrupted: review the outcome");
    out property <string> title-output: @tr("Output & verification");
    public pure function picker-error(error: string) -> string { return @tr("File picker unavailable: {}. Enter a path manually.", error); }
    out property <string> exporting-plan: @tr("Exporting selection…");
    out property <string> exporting-diagnostics: @tr("Exporting diagnostics…");
    public pure function plan-exported(path: string) -> string { return @tr("Selection exported to {}", path); }
    public pure function diagnostics-exported(path: string) -> string { return @tr("Diagnostics exported to {}", path); }
    public pure function plan-exists(path: string) -> string { return @tr("Selection export {}: file already exists. Choose a new path.", path); }
    public pure function diagnostics-exists(path: string) -> string { return @tr("Diagnostics export {}: file already exists; choose a new path.", path); }
    public pure function plan-export-error(path: string, error: string) -> string { return @tr("Selection export {}: {}. A partial file may remain.", path, error); }
    public pure function diagnostics-export-error(path: string, error: string) -> string { return @tr("Diagnostics export {}: {}. A partial file may remain.", path, error); }
    out property <string> precondition-busy: @tr("An operation is already running.");
    out property <string> precondition-engine: @tr("Connect a compatible bme engine first.");
    out property <string> precondition-image: @tr("Choose an original image first.");
    out property <string> precondition-import: @tr("Choose a selection file to open.");
    out property <string> precondition-scan: @tr("Scan the original image and selected catalog first.");
    out property <string> precondition-selection: @tr("Select an eligible correction first.");
    out property <string> precondition-build: @tr("Choose a new output path for the selected corrections.");
    out property <string> precondition-output: @tr("Choose a built output first.");
    out property <string> precondition-plan: @tr("Open the matching selection file first.");
    out property <string> precondition-manifest: @tr("Choose an output with its paired manifest first.");
    out property <string> precondition-recipe-mismatch: @tr("The selection file must match the scan and use only corrections supported by the desktop.");
    out property <string> precondition-wait-import: @tr("Wait for the active operation before opening a selection file.");
    out property <string> tool-ready: @tr("Ready");
    out property <string> tool-attention: @tr("Needs attention");
    out property <string> tool-missing: @tr("Missing");
    out property <string> tool-optional: @tr("Not installed (optional)");
    out property <string> tool-install: @tr("Download and install");
    out property <string> tool-choose: @tr("Choose location…");
    out property <string> tool-reset: @tr("Reset");
    out property <string> tool-install-unavailable: @tr("Automatic installation is available on Linux only.");
    out property <string> tool-install-with: @tr("Install with");
    out property <string> tool-install-note: @tr("Downloads the pinned release and checks its SHA-256 digest. This can take several minutes.");
    out property <string> tool-purpose-ghidra: @tr("Analyzes extracted firmware modules.");
    out property <string> tool-purpose-firmware-utils: @tr("Teaches Ghidra the UEFI firmware formats.");
    out property <string> tool-purpose-java: @tr("Runs Ghidra.");
    out property <string> tool-purpose-jdk: @tr("Builds the Ghidra extension during installation.");
    out property <string> tool-purpose-git: @tr("Fetches the Ghidra extension source during installation.");
    out property <string> tool-purpose-nasm: @tr("Assembles patch sources when you rebuild their hunks.");
    out property <string> tool-purpose-flashrom: @tr("Reads and writes the SPI flash chip.");
    out property <string> tool-choose-ghidra: @tr("Choose the Ghidra folder");
    out property <string> tool-choose-flashrom: @tr("Choose the flashrom program");
    out property <string> operation-tool-change: @tr("Updating tool location");
    out property <string> operation-tool-install: @tr("Installing Ghidra");

    out property <string> operation-flash-doctor: @tr("Diagnosing the system");
    out property <string> operation-flash-probe: @tr("Looking for the flash chip");
    out property <string> operation-flash-backup: @tr("Backing up the flash chip");
    out property <string> operation-flash-check: @tr("Checking the image against the chip");
    out property <string> operation-flash-write: @tr("Writing the flash chip. Do not power off");
    out property <string> status-flash-diagnosed: @tr("System diagnosis complete.");
    out property <string> status-flash-probed: @tr("Flash chip found.");
    out property <string> status-flash-checked: @tr("The backup matches the chip. Review what will be written before flashing.");
    out property <string> status-flash-written: @tr("Chip written and read back. Power-cycle the board to start the new firmware.");
    out property <string> status-closing-flash: @tr("Working on the flash chip. Close the window after the operation finishes.");
    out property <string> status-flash-inputs: @tr("Flash inputs changed. Check the image against the chip again.");
    public pure function status-flash-backed-up(path: string) -> string { return @tr("Chip backed up to {}", path); }
    public pure function status-flash-unknown(detail: string) -> string { return @tr("The chip may hold a partial image. Keep the board powered and restore the backup. {}", detail); }
    out property <string> precondition-flash-unsupported: @tr("The connected bme engine has no flash chip commands. Use the bundled engine.");
    out property <string> precondition-tools-unsupported: @tr("The connected bme engine cannot list or change tools. Use the bundled engine.");
    out property <string> precondition-programmer: @tr("Enter a flashrom programmer such as internal or ch341a_spi.");
    out property <string> precondition-flash-backup: @tr("Choose a backup file first.");
    out property <string> precondition-flash-image: @tr("Choose the image to write first.");
    out property <string> precondition-flash-check: @tr("Check the image against the chip first.");
    out property <string> precondition-flash-acknowledge: @tr("Confirm that you can recover the board first.");
    out property <string> flash-save-backup: @tr("Save the chip backup as a new file");
    out property <string> flash-open-backup: @tr("Open a backup of this chip");
    out property <string> flash-open-image: @tr("Open the image to write");
    out property <string> flash-pass: @tr("PASS");
    out property <string> flash-warn: @tr("WARN");
    out property <string> flash-fail: @tr("FAIL");
    out property <string> flash-info: @tr("INFO");
    public pure function flash-board(board: string) -> string { return @tr("Board: {}", board); }
    public pure function flash-firmware(firmware: string) -> string { return @tr("Firmware: {}", firmware); }
    public pure function flash-catalog-board(id: string) -> string { return @tr("Catalog board profile: {}", id); }
    out property <string> flash-no-catalog-board: @tr("No catalog board profile names this board.");
    public pure function flash-checks(programmer: string) -> string { return @tr("Checks for programmer {}", programmer); }
    out property <string> flash-ready: @tr("Nothing blocks chip access. Next: find the chip, then back it up.");
    out property <string> flash-not-ready: @tr("Fix the FAIL lines before reading or writing the chip.");
    public pure function flash-chip(chip: string) -> string { return @tr("Chip: {}", chip); }
    out property <string> flash-ambiguous: @tr("Several chip definitions match. Read the marking on the chip and use the bme CLI with --chip.");
    out property <string> flash-probe-next: @tr("Next: choose a new backup file and back up the chip.");
    public pure function flash-backup-summary(path: string, size: string, digest: string) -> string { return @tr("Backup: {}\n{} bytes · SHA-256 {}\nTwo reads matched. Keep this file: it is the only way back.", path, size, digest); }
    public pure function flash-partial(regions: string) -> string { return @tr("Only these regions were read: {}", regions); }
    public pure function flash-volumes(count: string) -> string { return @tr("Firmware volumes found: {}", count); }
    public pure function flash-not-firmware(note: string) -> string { return @tr("Not recognized as UEFI firmware: {}", note); }
    out property <string> flash-backup-next: @tr("Next: build a patched copy from this backup in Workflow, then check it here.");
    public pure function flash-check-summary(digest: string) -> string { return @tr("The backup matches the chip.\nImage SHA-256: {}\n\nWill write:", digest); }
    public pure function flash-region(name: string, start: string, end: string, changed: string) -> string { return @tr("{}  {}–{}  {} bytes change", name, start, end, changed); }
    out property <string> flash-check-next: @tr("Nothing was written yet. Confirm that you can recover the board, then choose Flash chip.");
    public pure function flash-written-summary(digest: string) -> string { return @tr("Written and read back. The chip holds image {}.\nPower-cycle the board to start the new firmware. Keep the backup.", digest); }
    public pure function flash-failure(message: string) -> string { return @tr("Failed: {}", message); }
}
